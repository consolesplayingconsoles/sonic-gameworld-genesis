# Sonic the Hedgehog's Gameworld, Pico to Mega Drive. Copy to .env (gitignored).

# The Pico dump to patch, referenced live and never committed.
PICO_ROM=""

# Which storybook page the conversion reports, 0 to 5. There is no page sensor
# on a Mega Drive, and the page is this game's mode selector, so one build
# reaches one page's activity.
PAGE=0

# The name this carries everywhere: the Lab library, a card, the drawer.
MOD_NAME="Genesis Conversion"
